# Nome do app exibido no header, login e título da aba
NEXT_PUBLIC_APP_NAME=Oeco Start

# URL da logo do cliente (deixe vazio para usar apenas o nome)
NEXT_PUBLIC_LOGO_URL=

# Cor primária em formato HEX (default: azul Oeco)
NEXT_PUBLIC_PRIMARY_COLOR=#1e3a5f

# URL do webhook do Marques (não visível na interface)
NEXT_PUBLIC_WEBHOOK_URL=https://exemplo.com/webhook

# Credenciais do Supabase (pegar no painel do Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# URL Base do Aplicativo em Produção / Domínio Oficial
NEXT_PUBLIC_APP_URL=https://app.oecofs.com

